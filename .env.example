# Имя приложения
APP_NAME=buh-ai-agent

# Окружение: local | dev | prod
APP_ENV=local

# Режим отладки (autoreload uvicorn)
DEBUG=false

# Директория Skills
SKILLS_DIR=.opencode/skills


# Настройки LLM
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60

# SQLite-хранилище (история диалогов, операции)
STORAGE_SQLITE_PATH=data/agent.db

# Лимит истории диалога: сколько последних сообщений передаётся LLM
AGENT_HISTORY_MESSAGES=10
AGENT_MAX_ITERATIONS=12
