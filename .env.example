# Имя приложения
APP_NAME=buh-ai-agent

# Окружение: local | dev | prod
APP_ENV=local

# Режим отладки (autoreload uvicorn)
DEBUG=false

# Директория Skills приложения (плейбуки под Tools приложения).
# Скиллы для внешних агентов живут отдельно: .opencode/skills/
SKILLS_DIR=skills


# Настройки LLM
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60

# SQLite-хранилище (история диалогов, операции)
STORAGE_SQLITE_PATH=data/agent.db

# Лимит истории диалога: сколько последних сообщений передаётся LLM
AGENT_HISTORY_MESSAGES=10
AGENT_MAX_ITERATIONS=12

# 1С OData: подключение приложения к базе 1С (обязательно для Tools 1С)
ONEC_BASE_URL=http://192.168.3.2/InfoBase2/odata/standard.odata/
ONEC_USERNAME=
ONEC_PASSWORD=
# Метка базы для операций (необязательно)
ONEC_DATABASE=

# Несколько баз 1С (необязательно): JSON-массив в ОДНУ строку.
# Если задан ONEC_DATABASES — он используется вместо ONEC_BASE_URL/USERNAME/
# PASSWORD/DATABASE выше. Поля элемента: name (уникальное имя базы — его агент
# передаёт в аргументе database), label (описание для агента и пользователя),
# base_url, username, password, organization_name/organization_inn
# (необязательно — иначе берутся общие ONEC_ORGANIZATION_*).
# При нескольких базах агент уточняет у пользователя, в какой базе работать,
# и передаёт её во все Tools 1С и create_operation.
# ONEC_DATABASES=[{"name":"osnovnaya","label":"Основная база (ИП Агентов)","base_url":"http://192.168.3.2/InfoBase2/odata/standard.odata/","username":"odata_ai","password":"…"},{"name":"filial","label":"Филиал (ООО Ромашка)","base_url":"http://192.168.3.2/InfoBase3/odata/standard.odata/","username":"odata_ai","password":"…"}]

# 1С: дефолты документов (необязательно — есть разумные значения)
# ONEC_ORGANIZATION_NAME=
# ONEC_ORGANIZATION_INN=
# ONEC_CURRENCY_CODE=643
# ONEC_VAT_RATE=НДС20
# ONEC_SUM_INCLUDES_VAT=true
# ONEC_UNIT_OF_MEASURE=шт

# 1С: правила безопасности записи (необязательно)
# ONEC_ALLOW_WRITE=true
# ONEC_ALLOW_POST=false
# ONEC_ALLOW_UNPOST=false
# ONEC_ALLOW_MARK_FOR_DELETION=false

# HTTP-сервис печати 1С (расширение; корневой URL сервиса) — официальные
# печатные формы (PDF). PDF прикладываются к ответу чата (base64) и не
# сохраняются приложением. Общий fallback для всех баз; у базы в
# ONEC_DATABASES можно задать свой print_service_url.
# Инструкция по развёртыванию — docs/onec-print-http-service.md
# ONEC_PRINT_SERVICE_URL=http://192.168.3.2/InfoBase2/hs/print
